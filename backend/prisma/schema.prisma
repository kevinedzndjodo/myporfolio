generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  challenges  String?
  outcome     String?
  year        Int?
  tech        String   // JSON array stored as string
  url         String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FaqItem {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
}

model Skill {
  id   Int    @id @default(autoincrement())
  name String @unique
  icon String
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
